# copy to .env and adjust if the API isn't running on the default port
VITE_API_BASE_URL=http://localhost:8000

# cluster used to build "Verify on-chain" Solana Explorer links
VITE_SOLANA_CLUSTER=devnet

# Only needed if the backend has API_KEY set. Sent as the X-API-Key header on
# the contribution + AI-briefing calls. Note: anything shipped to the browser
# is readable by users - this gates casual abuse, not a determined attacker.
VITE_API_KEY=
