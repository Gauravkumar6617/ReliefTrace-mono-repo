# TODO(you): copy this to .env and fill in real values before running anything.
# I'm keeping actual secrets out of git - I'll add my own .env locally.

SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=your_username
SNOWFLAKE_DATABASE=RELIEFTRACE_DB
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_WAREHOUSE=GENEROSITY_WH
SNOWFLAKE_ROLE=

# Preferred: key-pair auth (works even when MFA is enforced on the user).
# Generate with:
#   openssl genrsa 2048 | openssl pkcs8 -topk8 -inform PEM -out keys/snowflake_rsa_key.p8 -nocrypt
#   openssl rsa -in keys/snowflake_rsa_key.p8 -pubout -out keys/snowflake_rsa_key.pub
# then register the public key on the user:
#   ALTER USER your_username SET RSA_PUBLIC_KEY='<contents of .pub, header/footer stripped>';
SNOWFLAKE_PRIVATE_KEY_PATH=keys/snowflake_rsa_key.p8
# only needed if the key above was generated with a passphrase
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# Fallback: plain password auth. Only used when SNOWFLAKE_PRIVATE_KEY_PATH is unset.
# Fails for MFA-enforced users - key-pair auth above is what I'd use instead.
SNOWFLAKE_PASSWORD=your_password

# "production" disables the /docs, /redoc, /openapi.json routes - leave as
# development for local testing.
ENVIRONMENT=development

# Comma-separated list of origins allowed to call this API (CORS). Vite's
# default port is 5173 but it'll pick the next free one if that's taken.
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5174

# Free key from https://aistudio.google.com/apikey - powers the AI Situation
# Briefing endpoint. Without it, that one endpoint 503s; everything else works.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Solana devnet. Defaults are fine; override RPC only if the public one is
# rate-limiting you. Wallet lives in keys/wallet.json (auto-created, git-ignored).
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# Optional: if set and reachable, insight-query results are cached in Redis
# (survives backend restarts). Leave blank to use the in-process cache.
#   Upstash (recommended):  rediss://default:<token>@<host>.upstash.io:6379
#   Local Docker:           redis://localhost:6379/0   (docker run -d -p 6379:6379 redis:7-alpine)
REDIS_URL=
